# Generated fixtures (rebuilt by tests/fixtures/build_decks.py).
#
# The glob is non-recursive, so the hand-authored decks committed under
# tests/fixtures/pptx_samples/ are unaffected — see the provenance README
# there. That looks contradictory at a glance; it is not.
tests/fixtures/*.pptx

